                    StartedAt = started,
                    CompletedAt = DateTimeOffset.UtcNow
                });
            }

            var installed = _isInstalledLookup(appName);
            return Task.FromResult(new CheckResult
            {
                CheckId = request.CheckId,
                Status = installed ? CheckStatus.Pass : CheckStatus.Fail,
