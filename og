<?xml version="1.0" encoding="UTF-8"?>
<!--
  FIX: this file closes the gap in installer/README.md, which previously
  only described what an installer *should* do without any actual WiX
  source in the repo. This is a WiX v4 (wix.exe / WixToolset.Sdk) source
  file — build with:

      dotnet publish ..\src\CygnusAgent.Service -c Release -r win-x64 ^
        -p:PublishProfile=win-x64-selfcontained -o .\payload

      wix build CygnusAgentSetup.wxs -d PayloadDir=.\payload -o CygnusAgentSetup.msi

  Everything below maps 1:1 to installer/README.md "What it must do, in
  order" — read that file alongside this one.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
     xmlns:fw="http://wixtoolset.org/schemas/v4/wxs/firewall">

  <Package Name="CYGNUS 658 Agent"
           Manufacturer="CYGNUS"
           Version="1.0.0.0"
           UpgradeCode="8e6a6b8e-9c1a-4b3e-9f2a-0f6c1b6a1a01"
           Scope="perMachine">

    <!-- /enroll:<token> and /quiet are standard MSI properties, mapped by
         the bootstrapper (see installer/README.md). CYGNUSENROLLTOKEN is
         read ONCE by the service at first start via the environment
         variable set below, and is never written to disk by this
         installer — matching the "never persist the token" requirement. -->
    <Property Id="CYGNUSENROLLTOKEN" Secure="no" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of the CYGNUS Agent is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- FIX (error handling / "clean Windows PC" gap): refuse to install on
         an unsupported OS instead of silently placing a service that will
         fail every check at runtime. VersionNT >= 603 = Windows 8.1/Server
         2012 R2 or later (net8.0-windows's practical floor); 64-bit only,
         matching the win-x64 self-contained publish. Both conditions are
         evaluated by the MSI engine itself before any files are copied. -->
    <Launch Condition="Installed OR VersionNT >= 603"
            Message="CYGNUS Agent requires Windows 8.1 / Windows Server 2012 R2 or later." />
    <Launch Condition="Installed OR VersionNT64"
            Message="CYGNUS Agent requires a 64-bit version of Windows." />

    <!-- Step 3: %ProgramData%\CygnusAgent\ with ACLs locked to
         SYSTEM + Administrators, so the DPAPI-protected credential blob,
         offline queue, and logs aren't readable by a standard user. -->
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="CYGNUSDATADIR" Name="CygnusAgent">
        <Component Id="DataDirAcl" Guid="1a2b3c4d-0001-4000-8000-000000000001">
          <CreateFolder>
            <util:PermissionEx User="SYSTEM" GenericAll="yes" />
            <util:PermissionEx User="Administrators" GenericAll="yes" />
            <!-- Deliberately no grant to Users/Everyone -->
          </CreateFolder>
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- Step 1: copy the self-contained, single-file service exe. -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="CygnusAgent">
        <Component Id="ServiceBinary" Guid="1a2b3c4d-0002-4000-8000-000000000002">
          <File Id="CygnusAgentServiceExe"
                Source="$(var.PayloadDir)\CygnusAgent.Service.exe"
                KeyPath="yes" />

          <!-- Step 2: register the Event Log source. Requires the
               installer's admin context — the running service (which
               should use a least-privileged service account) can't
               register this for itself. -->
          <util:EventSource Log="Application"
                             Name="CygnusAgent"
                             EventMessageFile="[#CygnusAgentServiceExe]" />

          <!-- Step 4 + 5 + 6: register the Windows Service, auto-start
               with crash recovery, pass CYGNUSENROLLTOKEN as a one-time
               environment variable read at first start only (see
               AgentWorker.EnsureEnrolledAsync — it reads
               CYGNUS_ENROLL_TOKEN once and never persists it). -->
          <ServiceInstall Id="CygnusAgentServiceInstall"
                           Name="CygnusAgent"
                           DisplayName="CYGNUS 658 Agent"
                           Description="Endpoint verification and remediation agent for CYGNUS 658."
                           Type="ownProcess"
                           Start="auto"
                           Account="LocalSystem"
                           ErrorControl="normal">
            <!-- Restart on crash with backoff, per docs/ARCHITECTURE.md
                 "no infinite retry loop" spirit — bounded, not silent. -->
            <ServiceConfig DelayedAutoStart="no" OnInstall="yes" OnReinstall="yes" />
          </ServiceInstall>

          <ServiceControl Id="CygnusAgentServiceControl"
                           Name="CygnusAgent"
                           Start="install"
                           Stop="both"
                           Remove="uninstall"
                           Wait="yes" />

          <Environment Id="EnrollTokenEnv"
                       Name="CYGNUS_ENROLL_TOKEN"
                       Value="[CYGNUSENROLLTOKEN]"
                       Permanent="no"
                       System="yes"
                       Action="set" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="CYGNUS Agent" Level="1">
      <ComponentRef Id="DataDirAcl" />
      <ComponentRef Id="ServiceBinary" />
    </Feature>

    <!-- Step 7: on /quiet, suppress UI. On failure, exit non-zero so
         RMM/GPO tooling can detect it — WiX's own exit-code behavior
         already does this; no custom action silently swallows errors. -->
    <ui:WixUI xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui" Id="WixUI_Minimal" />

  </Package>
</Wix>

