    /// docs/API_CONTRACT.md "Common envelope fields"). Doing this in a
    /// DelegatingHandler — rather than merging these fields into each call
    /// site's anonymous `body` object — means:
    ///   1. every call gets them uniformly, with no risk of a new endpoint
    ///      forgetting to add them;
    ///   2. the credential is read from ICredentialStore (DPAPI) at request
    ///      time and never held longer than one call, and never logged as
    ///      part of a request-body dump (StructuredLogger's redaction is a
    ///      backstop, this is the primary control).
    ///
    /// The enroll call is the one exception: it has no credential yet (the
    /// backend issues one in the response), so this handler skips injection
    /// when the JSON body's "action" is "agent.enroll".
    /// </summary>
    public sealed class CredentialAttachingHandler : DelegatingHandler
    {
        private readonly ICredentialStore _credentialStore;
        private readonly AgentConfig _config;

        public CredentialAttachingHandler(ICredentialStore credentialStore, AgentConfig config)
        {
            _credentialStore = credentialStore;
            _config = config;
        }

        protected override async Task<HttpResponseMessage> SendAsync(HttpRequestMessage request, CancellationToken ct)
        {
            if (request.Content is not null)
            {
                var originalJson = await request.Content.ReadAsStringAsync(ct);

                using var doc = JsonDocument.Parse(originalJson);
                var isEnroll = doc.RootElement.TryGetProperty("action", out var actionProp)
                               && actionProp.GetString() == "agent.enroll";

                using var stream = new System.IO.MemoryStream();
                using (var writer = new Utf8JsonWriter(stream))
                {
                    writer.WriteStartObject();
                    foreach (var prop in doc.RootElement.EnumerateObject())
                        prop.WriteTo(writer);

                    // Common envelope fields — see API_CONTRACT.md.
                    writer.WriteString("agentVersion", _config.AgentVersion);
                    writer.WriteString("requestId", Guid.NewGuid().ToString("N"));

                    if (!isEnroll)
                    {
                        writer.WriteString("deviceId", _config.DeviceId);
                        if (_credentialStore.TryLoad(out var credential))
                            writer.WriteString("credential", credential);
                        // If no credential is available yet and this isn't an
                        // enroll call, we deliberately still send the request:
                        // the backend will reject it with an auth error, which
                        // is a clearer failure than the Agent guessing.
                    }

                    writer.WriteEndObject();
                }

                var newJson = Encoding.UTF8.GetString(stream.ToArray());
                request.Content = new StringContent(newJson, Encoding.UTF8, "application/json");
            }

            return await base.SendAsync(request, ct);
        }
    }
}

