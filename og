## `build.ps1`

```powershell
<#
.SYNOPSIS
  CYGNUS Agent build + package script. DEVELOPER MACHINE ONLY — this script
  itself, and the WiX/signtool tooling it calls, are never something the
  end user runs or needs installed. The end user only ever touches the
  CygnusAgentSetup.exe / .msi this script produces.

.PARAMETER CertThumbprint
  Optional. Thumbprint of a code-signing certificate already installed in
  the current user's certificate store. If supplied, both the published
  CygnusAgent.Service.exe and the final installer are signed with signtool.
  If omitted, the build still completes (per the "ideally signed" — not
  "must be signed" — requirement) but prints a clear warning, since an
  unsigned installer will show "Unknown Publisher" in Windows SmartScreen.

.PARAMETER TimestampUrl
  Optional RFC 3161 timestamp server, so the signature stays valid after
  the certificate itself expires. Defaults to DigiCert's public server.

.EXAMPLE
  .\build.ps1
  .\build.ps1 -CertThumbprint AB12CD34EF56...
#>
[CmdletBinding()]
param(
    [string]$CertThumbprint,
    [string]$TimestampUrl = "http://timestamp.digicert.com"
)

$ErrorActionPreference = "Stop"
$root = Split-Path -Parent $MyInvocation.MyCommand.Path
$serviceProject = Join-Path $root "src\CygnusAgent.Service"
$payloadDir = Join-Path $root "installer\payload"
$installerDir = Join-Path $root "installer"
$wxsFile = Join-Path $installerDir "CygnusAgentSetup.wxs"
$msiOut = Join-Path $installerDir "CygnusAgentSetup.msi"

function Assert-Tool($name, $checkCommand) {
    if (-not (Get-Command $checkCommand -ErrorAction SilentlyContinue)) {
        throw "$name not found on PATH. This script is for the BUILD machine only — see docs/DEPLOYMENT.md for developer-machine requirements."
    }
}

function Sign-File($path) {
    if (-not $CertThumbprint) { return }
    Write-Host "Signing $path ..."
    & signtool sign /sha1 $CertThumbprint /fd SHA256 /tr $TimestampUrl /td SHA256 $path
    if ($LASTEXITCODE -ne 0) { throw "signtool failed on $path (exit $LASTEXITCODE)" }
}

Write-Host "== 1. Prerequisite check ==" -ForegroundColor Cyan
Assert-Tool ".NET 8 SDK" "dotnet"
Assert-Tool "WiX v4 CLI" "wix"
if ($CertThumbprint) {
    Assert-Tool "signtool (Windows SDK)" "signtool"
} else {
    Write-Warning "No -CertThumbprint supplied — the resulting installer and exe will be UNSIGNED. Windows SmartScreen will show 'Unknown Publisher' when the end user runs it. Pass -CertThumbprint once you have a code-signing certificate."
}

Write-Host "== 2. Restore + build (sanity check) ==" -ForegroundColor Cyan
dotnet restore "$root\CygnusAgent.sln"
if ($LASTEXITCODE -ne 0) { throw "dotnet restore failed (exit $LASTEXITCODE)" }
dotnet build "$root\CygnusAgent.sln" -c Release
if ($LASTEXITCODE -ne 0) { throw "dotnet build failed (exit $LASTEXITCODE)" }

Write-Host "== 3. Publish self-contained single-file service exe ==" -ForegroundColor Cyan
if (Test-Path $payloadDir) { Remove-Item $payloadDir -Recurse -Force }
dotnet publish $serviceProject -c Release -r win-x64 -p:PublishProfile=win-x64-selfcontained -o $payloadDir
if ($LASTEXITCODE -ne 0) { throw "dotnet publish failed (exit $LASTEXITCODE)" }

$serviceExe = Join-Path $payloadDir "CygnusAgent.Service.exe"
if (-not (Test-Path $serviceExe)) { throw "Expected publish output not found: $serviceExe" }
Sign-File $serviceExe

Write-Host "== 4. Build installer (WiX) ==" -ForegroundColor Cyan
Push-Location $installerDir
try {
    wix build $wxsFile -d "PayloadDir=$payloadDir" -o $msiOut
    if ($LASTEXITCODE -ne 0) { throw "wix build failed (exit $LASTEXITCODE)" }
} finally {
    Pop-Location
}

Sign-File $msiOut

Write-Host "== Done ==" -ForegroundColor Green
Write-Host "Installer: $msiOut"
if (-not $CertThumbprint) {
    Write-Host "Reminder: this build is UNSIGNED. Re-run with -CertThumbprint before shipping to end users." -ForegroundColor Yellow
}

```

