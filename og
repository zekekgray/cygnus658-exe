```csharp
using System;
using System.IO;
using System.Linq;
using System.Management;
using System.ServiceProcess;
using Microsoft.Win32;

namespace CygnusAgent.Service
{
    /// <summary>
    /// FIX: real implementations — all via managed Windows APIs
    /// (Microsoft.Win32.Registry, System.ServiceProcess, System.Management/WMI).
    /// Deliberately NO Process.Start("powershell.exe"/"cmd.exe", ...) anywhere
    /// in this class: shelling out would mean the Agent has a runtime
    /// dependency on PowerShell being present/unrestricted, which contradicts
    /// the "no PowerShell required" product requirement and would also widen
    /// the Agent's attack surface (see docs/THREAT_MODEL.md — no arbitrary
    /// shell execution, by construction).
    /// </summary>
    internal static class WindowsLookups
    {
        private static readonly string[] UninstallRoots =
        {
            @"SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall",
            @"SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall"
        };

        public static bool IsApplicationInstalled(string applicationName)
        {
            foreach (var root in UninstallRoots)
            {
                using var key = Registry.LocalMachine.OpenSubKey(root);
                if (key is null) continue;

                foreach (var subKeyName in key.GetSubKeyNames())
                {
                    using var subKey = key.OpenSubKey(subKeyName);
                    var displayName = subKey?.GetValue("DisplayName") as string;
                    if (displayName is not null &&
                        displayName.Contains(applicationName, StringComparison.OrdinalIgnoreCase))
                        return true;
                }
            }
            return false;
        }

        public static string? GetServiceStatus(string serviceName)
        {
            try
            {
                using var sc = new ServiceController(serviceName);
                return sc.Status.ToString(); // e.g. "Running", "Stopped", "StartPending"
            }
            catch (InvalidOperationException)
            {
                // Service does not exist on this machine.
                return null;
            }
        }

        public static bool ApplyServiceState(string serviceName, string targetState)
        {
            try
            {
                using var sc = new ServiceController(serviceName);

                switch (targetState)
                {
                    case "Running":
                        if (sc.Status != ServiceControllerStatus.Running)
                        {
                            sc.Start();
                            sc.WaitForStatus(ServiceControllerStatus.Running, TimeSpan.FromSeconds(30));
                        }
                        return true;

                    case "Stopped":
                        if (sc.Status != ServiceControllerStatus.Stopped)
                        {
                            sc.Stop();
                            sc.WaitForStatus(ServiceControllerStatus.Stopped, TimeSpan.FromSeconds(30));
                        }
                        return true;

                    case "Disabled":
                        // ServiceController has no start-mode setter; the start
                        // mode lives on the WMI Win32_Service class instead.
                        using (var searcher = new ManagementObjectSearcher(
                                   $"SELECT * FROM Win32_Service WHERE Name = '{EscapeWmi(serviceName)}'"))
                        {
                            foreach (ManagementObject service in searcher.Get())
                            {
                                var result = (uint)service.InvokeMethod("ChangeStartMode", new object[] { "Disabled" });
                                return result == 0; // 0 = success per Win32_Service.ChangeStartMode
                            }
                        }
                        return false;

                    default:
                        return false;
                }
            }
            catch (Exception)
            {
                return false;
            }
        }

        public static string? GetVolumeEncryptionStatus(string volume)
        {
            // Win32_EncryptableVolume lives in the ROOT\CIMV2\Security\MicrosoftVolumeEncryption
            // namespace. Absent (e.g. BitLocker feature not installed, or
            // running under an account without access) → treat as
            // "unsupported" (NotApplicable at the check layer), not a failure.
            try
            {
                var scope = new ManagementScope(@"root\CIMV2\Security\MicrosoftVolumeEncryption");
                scope.Connect();

                var normalizedVolume = volume.TrimEnd('\\') + "\\";
                using var searcher = new ManagementObjectSearcher(scope,
                    new ObjectQuery($"SELECT * FROM Win32_EncryptableVolume WHERE DriveLetter = '{EscapeWmi(volume.TrimEnd('\\'))}'"));

                foreach (ManagementObject vol in searcher.Get())
                {
                    var result = vol.InvokeMethod("GetConversionStatus", null);
                    // ConversionStatus: 0 FullyDecrypted, 1 FullyEncrypted,
                    // 2 EncryptionInProgress, 3 DecryptionInProgress, 4 EncryptionPaused, 5 DecryptionPaused
                    var conversionStatus = Convert.ToUInt32(((ManagementBaseObject)result!)["ConversionStatus"]);
                    return conversionStatus == 1 ? "Encrypted" : "NotEncrypted";
                }

                return null; // no matching volume — unsupported for this query
            }
            catch (ManagementException)
            {
                return null;
            }
            catch (UnauthorizedAccessException)
            {
                return null;
            }
        }

        public static string? ReadSecuritySetting(string settingKey)
        {
            // Closed dispatch table, same allowlisting pattern as
            // RemediationEngine/CheckEngine: an unrecognized settingKey
            // returns null (NotApplicable), never a generic "read anything
            // from the registry" fallback.
            return settingKey switch
            {
                "ScreenSaverTimeoutSeconds" => ReadRegistryValue(
                    Registry.CurrentUser, @"Control Panel\Desktop", "ScreenSaveTimeOut"),
                "WindowsFirewallDomainEnabled" => ReadRegistryValue(
                    Registry.LocalMachine,
                    @"SOFTWARE\Policies\Microsoft\WindowsFirewall\DomainProfile", "EnableFirewall"),
                "WindowsFirewallStandardEnabled" => ReadRegistryValue(
                    Registry.LocalMachine,
                    @"SOFTWARE\Policies\Microsoft\WindowsFirewall\StandardProfile", "EnableFirewall"),
                _ => null
            };
        }

        private static string? ReadRegistryValue(RegistryKey hive, string path, string valueName)
        {
            using var key = hive.OpenSubKey(path);
            var value = key?.GetValue(valueName);
            return value?.ToString();
        }

        private static string EscapeWmi(string value) => value.Replace("'", "''");
    }

    internal static class WindowsEventLogSink
    {
        private static readonly string FallbackLogPath =
            Environment.ExpandEnvironmentVariables(@"%ProgramData%\CygnusAgent\logs\agent.log");

        public static void Write(string jsonLine)
        {
            try
            {
                Directory.CreateDirectory(Path.GetDirectoryName(FallbackLogPath)!);
                File.AppendAllText(FallbackLogPath, jsonLine + Environment.NewLine);
            }
            catch
            {
            }
        }
    }
}

